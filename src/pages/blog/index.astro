---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostDates from "../../components/PostDates.astro";
import TagBrowser from "../../components/TagBrowser.astro";
import { getTagHref } from "../../utils/blogTags";
import { comparePosts } from "../../utils/contentOrder.mjs";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort(comparePosts);
const tagCounts = posts.flatMap((post) => post.data.tags).reduce((counts, tag) => {
  counts.set(tag, (counts.get(tag) ?? 0) + 1);
  return counts;
}, new Map<string, number>());
const tags = [...tagCounts]
  .sort(([a], [b]) => a.localeCompare(b, "zh-CN"))
  .map(([name, count]) => ({ name, count, href: getTagHref(name) }));
---

<BaseLayout title="Blog" description="Learning notes, project retrospectives, and technical essays">
  <section class="page-intro blog-intro">
    <p class="eyebrow">WRITING</p>
    <h1>Blog</h1>
    <p>Learning notes, project retrospectives, and technical essays.</p>
  </section>

  <TagBrowser tags={tags} />

  <section class="post-list">
    {posts.length === 0 ? (
      <div class="empty-state">The first article is on its way.</div>
    ) : posts.map((post, index) => (
      <article class:list={["post-card", { "is-pinned": post.data.pinned }]}>
        <div class="post-index">{String(index + 1).padStart(2, "0")}</div>
        <div class="post-main">
          <div class="post-meta">
            {post.data.pinned && <span class="pin-badge">Pinned</span>}
            <PostDates publishedAt={post.data.publishedAt} updatedAt={post.data.updatedAt} />
            <span aria-hidden="true">·</span>
            <div class="post-tags">
              {post.data.tags.length > 0
                ? post.data.tags.map((tag) => <a href={getTagHref(tag)}>#{tag}</a>)
                : <span>Notes</span>}
            </div>
          </div>
          <h2><a class="post-title-link" href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
        </div>
        <span class="arrow" aria-hidden="true">→</span>
      </article>
    ))}
  </section>
</BaseLayout>
